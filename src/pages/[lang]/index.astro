---
import Page from "../../layouts/Page.astro";
import { locales, siteFor } from "../../lib/data";

export function getStaticPaths() {
  return locales
    .filter((l) => !l.isPrimary)
    .map((l) => ({ params: { lang: l.code }, props: { code: l.code } }));
}

const { code } = Astro.props;
---

<Page site={siteFor(code)} locales={locales} current={code} />
