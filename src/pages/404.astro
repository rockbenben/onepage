---
import "../styles/global.css";
import { locales, siteFor } from "../lib/data";
import { getUI } from "../i18n/ui";

// 404 页跟着主语言走：locales[0] 是按文件名自动发现出的主语言（见 src/lib/locales.ts，
// v2 已取消 site.languages 发布开关），首页语言变了 404 也要一起变，
// 不能写死主文件的语言（否则首页是英文时 404 仍是中文）
const site = siteFor(locales[0].code);
const t = getUI(site.lang);
---

<html
  lang={site.lang}
  data-theme={site.themeName}
  data-appearance={site.appearance}
  style={site.accent ? `--color-accent:${site.accent.accent};--color-accent-2:${site.accent.accent2}` : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>404 · {site.name}</title>
  </head>
  <body class="mx-auto flex min-h-screen max-w-5xl flex-col items-start justify-center px-5">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight">{t.notFoundTitle}</h1>
    <p class="mt-4 text-(--color-ink-2)">{t.notFoundBody}</p>
    <a href="/" class="btn btn-primary mt-8">{t.notFoundBack}</a>
  </body>
</html>
