---
import "../styles/global.css";
import { site } from "../lib/data";
---

<html lang={site.lang} style={`--color-accent:${site.theme.accent};--color-accent-2:${site.theme.accent2}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>404 · {site.profile.name}</title>
  </head>
  <body class="mx-auto flex min-h-screen max-w-5xl flex-col items-start justify-center px-5">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight">这一页不存在</h1>
    <p class="mt-4 text-(--color-ink-2)">要找的东西可能改了地址，或者还没做出来。</p>
    <a href="/" class="btn btn-primary mt-8">回到首页</a>
  </body>
</html>
