---
// 重点大卡：名字 / 介绍 / 缩略图 / demo 链接 / 源码 / ★（tagline、tags 已死）
// 列数走 1 → sm:2 → lg:3，与 OpenSourceSection 同一套台阶：md(768) 就跳 3 列会把
// 1200×630 的缩略图压到 ~230px 宽（728 内容宽 ÷ 3），比 SCREEN_SPEC 写的「平板 2 列」还挤。
import { repoOf, fmtStars, thumbOf } from "../lib/data";
import { fmt } from "../i18n/ui";
import SectionHeader from "./SectionHeader.astro";

const { items, t } = Astro.props;
---

<section class="mt-16">
  <SectionHeader title={t.featuredTitle} subtitle={t.featuredSubtitle} />
  <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((f: any) => {
      const r = repoOf(f);
      const img = thumbOf(f);
      const main = f.link ?? f.source;
      return (
        <article class="card flex flex-col overflow-hidden">
          {img && main && (
            <a href={main} target="_blank" rel="noopener noreferrer" class="thumb block aspect-social overflow-hidden border-b border-(--color-line)">
              <img src={img} alt={fmt(t.thumbAlt, { name: f.name })} loading="lazy" class="h-full w-full object-contain" />
            </a>
          )}
          {img && !main && (
            <div class="thumb block aspect-social overflow-hidden border-b border-(--color-line)">
              <img src={img} alt={fmt(t.thumbAlt, { name: f.name })} loading="lazy" class="h-full w-full object-contain" />
            </div>
          )}
          <div class="flex grow flex-col p-6">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-semibold">{f.name}</h3>
              {r && r.stars >= 10 && <span class="chip chip-star">★ {fmtStars(r.stars)}</span>}
            </div>
            {f.desc && <p class="mt-2 grow text-sm leading-relaxed text-(--color-ink-2)">{f.desc}</p>}
            {(f.link || f.source) && (
              <div class="mt-3 flex items-center justify-between gap-4 text-sm">
                {f.link && (
                  <a class="inline-block py-2 font-medium text-(--color-accent) hover:underline" href={f.link} target="_blank" rel="noopener noreferrer">
                    {t.demo} →
                  </a>
                )}
                {f.source && (
                  <a class="inline-block py-2 text-(--color-ink-2) hover:text-(--color-accent) hover:underline" href={f.source} target="_blank" rel="noopener noreferrer">{t.source} ↗</a>
                )}
              </div>
            )}
          </div>
        </article>
      );
    })}
  </div>
</section>
