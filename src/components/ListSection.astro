---
import { repoOf, fmtStars, ghUrl } from "../lib/data";
import SectionHeader from "./SectionHeader.astro";

const { section } = Astro.props;
---

<section class="mt-16">
  <SectionHeader {...section} count={section.count ? section.items.length : undefined} />
  <ul class="mt-4 divide-y divide-(--color-line)">
    {section.items.map((it: any) => {
      const r = repoOf(it.repo);
      const src = ghUrl(it.repo);
      // 标题指向源码仓库（开源清单的正主）；无仓库时退回 url（文章、案例等）
      const nameHref = src ?? it.url;
      // 右侧只在有线上可用链接时给 Demo
      const demoHref = it.demo ?? (src && it.url ? it.url : undefined);
      return (
        <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-3.5">
          {it.date && <span class="mono w-24 shrink-0 text-xs text-(--color-ink-2)">{it.date}</span>}
          <div class="min-w-0 grow">
            {nameHref ? (
              <a href={nameHref} target="_blank" rel="noopener noreferrer" class="link-quiet font-medium">{it.name}</a>
            ) : (
              <span class="font-medium">{it.name}</span>
            )}
            {it.desc && <p class="mt-0.5 text-sm leading-relaxed text-(--color-ink-2)">{it.desc}</p>}
          </div>
          {r && r.stars >= 10 && <span class="chip chip-star">★ {fmtStars(r.stars)}</span>}
          {it.meta && <span class="mono shrink-0 text-xs text-(--color-ink-2)">{it.meta}</span>}
          {demoHref && (
            <a class="mono shrink-0 text-xs font-semibold text-(--color-accent) hover:text-(--color-accent-2) hover:underline" href={demoHref} target="_blank" rel="noopener noreferrer">{it.demoLabel ?? "Demo"}</a>
          )}
        </li>
      );
    })}
  </ul>
</section>
