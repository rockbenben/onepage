---
// Hero：头像 / 名字 / 头衔 / 介绍 + 统一链接按钮排。
// 顶部细条只剩 LangSwitch（eyebrow 与 #022 计数已随字段消亡）。
import { assets } from "../lib/data";
import SocialIcon from "./SocialIcon.astro";
import LangSwitch from "./LangSwitch.astro";

const { site, locales, current } = Astro.props;
// 头像：构建时抓取的缓存优先，其次配置里的手填地址
const avatar = assets.avatar ?? site.avatar;
// mailto: 与站内路径（/ 开头）不新开窗口；其余外链新标签打开
const isLocal = (u: string) => u.startsWith("mailto:") || u.startsWith("/");
---

<header class="pt-6">
  <div class={`flex items-baseline gap-4 border-b border-(--color-line) pb-4 ${site.mark ? "justify-between" : "justify-end"}`}>
    {site.mark && <span class="eyebrow text-(--color-ink)">{site.mark}</span>}
    <LangSwitch locales={locales} current={current} />
  </div>

  <div class="pt-14 pb-12">
    {avatar && (
      <img src={avatar} alt={site.name} width="72" height="72"
        class="mb-6 size-18 rounded-lg border border-(--color-line)" />
    )}
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">{site.name}</h1>
    {site.title && (
      <p class="mt-3 text-lg font-medium sm:text-xl">{site.title}</p>
    )}
    {site.intro && (
      <p class="mt-4 max-w-2xl leading-relaxed text-(--color-ink-2) sm:text-lg">{site.intro}</p>
    )}
    {site.links.length > 0 && (
      <div class="mt-7 flex flex-wrap gap-3">
        {site.links.map((l: any, i: number) => (
          <a href={l.url}
            target={isLocal(l.url) ? undefined : "_blank"}
            rel={isLocal(l.url) ? undefined : "noopener noreferrer"}
            class={i === 0 ? "btn btn-primary" : "btn"}>
            <span class="flex items-center gap-2">
              <SocialIcon url={l.url} label={l.label} />
              {l.label}
            </span>
          </a>
        ))}
      </div>
    )}
  </div>
</header>
