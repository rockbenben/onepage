---
// 区块小标题：标题 + 可选副标题（轻量说明）+ 可选自动计数
const { title, subtitle, count } = Astro.props;
---

{
  title && (
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-bold">
        {title}
        {subtitle && <span class="ml-2.5 text-sm font-normal text-(--color-ink-2)">{subtitle}</span>}
        {count != null && <span class="mono ml-2.5 text-sm font-normal text-(--color-ink-2)">{count}</span>}
      </h2>
    </div>
  )
}
