// 内置图标集；icon 未指定时按 url 自动识别，识别不了则回退通用链接图标（link）
const { icon, url } = Astro.props;

function detect(u: string): string {
  if (u.startsWith("mailto:")) return "email";
  if (/github\.com/.test(u)) return "github";
  if (/(^|\.)x\.com|twitter\.com/.test(u)) return "x";
  if (/rss|feed/.test(u)) return "rss";
  return "link";
}

